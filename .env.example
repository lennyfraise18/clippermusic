# Copie ce fichier en ".env" et remplis les valeurs.
# Sur Hugging Face Spaces, ces mêmes noms se saisissent dans
# Settings > Variables and secrets (en "Secret", pas en "Variable").

# Banque de vidéos n°1 — https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Banque de vidéos n°2 (secours si Pexels ne renvoie rien) — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Musique Creative Commons — https://devportal.jamendo.com/admin/applications
JAMENDO_CLIENT_ID=

# Modèle Whisper : tiny | base | small | medium
# "small" = bon compromis qualité/vitesse sur CPU. "base" si le Space est trop lent.
WHISPER_MODEL=small
